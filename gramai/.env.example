# Never commit real secrets. Copy this file to .env only on your machine/hosting provider.
GRAMAI_SECRET=replace-with-a-long-random-secret
GRAMAI_PAYMENT_DEMO=1
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxx

# Optional production providers
GRAMAI_SMTP_HOST=
GRAMAI_SMTP_PORT=587
GRAMAI_SMTP_USER=
GRAMAI_SMTP_PASSWORD=
GRAMAI_SMS_PROVIDER=DEMO

# GRAM Saathi assistant (Groq). Get a key at https://console.groq.com/keys
# Server-side only - never put this in static/ or commit a real value.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b
